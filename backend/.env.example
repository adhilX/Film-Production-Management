# Backend Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (change adapter and credentials as needed)
MONGO_URI=mongodb://localhost:27017/film_production
MONGO_URI_TEST=mongodb://localhost:27017/film_production_test

# Security & Authentication
JWT_SECRET=change_this_to_a_secure_random_key_in_production
JWT_EXPIRES_IN=1d

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000



# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
